# ─── DATABASE ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://sagman:sagman_dev_pass@localhost:5432/sagman_dev"

# PostgreSQL (for Docker Compose production)
POSTGRES_DB=sagman_prod
POSTGRES_USER=sagman
POSTGRES_PASSWORD=change-me-in-production

# ─── REDIS (optional in v1) ──────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=change-me-in-production

# ─── JWT ─────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-jwt-secret-minimum-64-chars
JWT_REFRESH_SECRET=your-very-long-random-refresh-secret-minimum-64-chars
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ─── API SERVER ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads
# Max upload size in bytes (5MB)
MAX_UPLOAD_SIZE=5242880

# ─── NEXT.JS ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── PRODUCTION URLs ─────────────────────────────────────────────────────────────
# API_URL=https://yourdomain.com
