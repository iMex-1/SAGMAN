{
  "name": "@sagman/db-drizzle",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sagman --remote",
    "db:migrate:local": "wrangler d1 migrations apply sagman --local",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed-runner.ts"
  },
  "dependencies": {
    "@sagman/shared": "workspace:*",
    "drizzle-orm": "^0.33.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240901.0",
    "@libsql/client": "^0.17.4",
    "@sagman/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
