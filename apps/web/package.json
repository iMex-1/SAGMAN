{
  "name": "@sagman/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build --skipWranglerConfigCheck && cp .open-next/worker.js .open-next/_worker.js && printf '%s\\n' 'name = \"sagman\"' 'pages_build_output_dir = \".\"' 'compatibility_date = \"2024-11-11\"' 'compatibility_flags = [\"nodejs_compat\"]' > .open-next/wrangler.toml",
    "cf-deploy": "opennextjs-cloudflare build --skipWranglerConfigCheck && cp .open-next/worker.js .open-next/_worker.js && printf '%s\\n' 'name = \"sagman\"' 'pages_build_output_dir = \".\"' 'compatibility_date = \"2024-11-11\"' 'compatibility_flags = [\"nodejs_compat\"]' > .open-next/wrangler.toml && cd .open-next && npx wrangler pages deploy . --project-name=sagman",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sagman/shared": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^5.6.3",
    "lucide-react": "^0.445.0",
    "next": "15.3.3",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.3.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.0"
  }
}
